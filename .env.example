# Supabase — replace with your project credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Vite client-side Supabase variables (same values as above, VITE_ prefix required)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Site URL - used for SEO metadata, sitemap, and redirect URLs.
# Production should set both values to the real public launch URL.
SITE_URL=https://edgescope.app
VITE_SITE_URL=https://edgescope.app
